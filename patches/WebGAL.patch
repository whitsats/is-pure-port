+        {/* Top Header Bar */}
+        <div className={`${styles.topBar} ${!showBars ? styles.topBarHidden : ''}`}>
+          {/* 左侧：返回按钮与卷目下拉触发器 */}
+          <div className={styles.topLeft}>
+            <button
+              className={`${styles.wgBtn} ${styles.backBtn}`}
