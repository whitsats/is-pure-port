@@ -0,0 +1,24 @@
+import { webgalStore } from '@/store/store';
+import { unlockCgInUserData } from '@/store/userDataReducer';
+import { setStorageAsync } from '@/Core/controller/storage/storageController';
+import { assetSetter, fileType } from '@/Core/util/gameAssetsAccess/assetSetter';
+
+/**
+ * 用剧情之外的演出（片头、片尾视频）实际开始播放时解锁一张 CG。
+ *
+ * 仍然走 WebGAL 原生 userData.appreciationData 和按 URL 去重的 reducer，
+ * 不新增旁路状态；缩略图路径与场景里的 unlockCg 一样由 assetSetter 补全。
+ */
+export const unlockCgFromAsset = (file: string, name: string, order = 0, thumb?: string): void => {
+  if (!file) return;
+  webgalStore.dispatch(
+    unlockCgInUserData({
+      name,
+      url: assetSetter(file, fileType.background),
+      series: 'default',
+      order,
+      thumb: thumb ? assetSetter(thumb, fileType.background) : undefined,
+    }),
+  );
+  void setStorageAsync();
+};
