+  bottom: calc(12px + max(env(safe-area-inset-bottom, 0px), var(--android-toolbar-bottom, 0px)));
+  min-height: 44px;
+  padding: 0 14px;
+  color: rgba(255, 255, 255, 0.62);
+  font-size: 14px;
+  text-shadow: 0 1px 8px #000d;
+  background: transparent;
+  border: none;
+}
