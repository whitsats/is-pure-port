+    /**
+     * 精确切片输入流，支持 O(1) 随机 Seek，严格按 contentLength 边界返回 EOF，避免 ERR_CONTENT_LENGTH_MISMATCH
+     */
+    private class BoundedInputStream(
+        file: File,
+        startPos: Long,
+        private val length: Long
+    ) : InputStream() {
+        private val raf = RandomAccessFile(file, "r").apply {
+            if (startPos > 0) seek(startPos)
+        }
+        private var remaining = length
+
+        override fun read(): Int {
+            if (remaining <= 0) return -1
+            val b = raf.read()
+            if (b != -1) remaining--
+            return b
+        }
+
+        override fun read(b: ByteArray, off: Int, len: Int): Int {
+            if (remaining <= 0) return -1
+            val toRead = Math.min(len.toLong(), remaining).toInt()
+            val bytesRead = raf.read(b, off, toRead)
+            if (bytesRead > 0) {
+                remaining -= bytesRead
+            }
+            return bytesRead
+        }
+
+        override fun available(): Int {
+            return Math.min(remaining, Int.MAX_VALUE.toLong()).toInt()
+        }
+
+        override fun close() {
+            try {
+                raf.close()
+            } catch (e: Exception) {
+                // ignore
+            }
+        }
+    }
+
+    /**
+     * 判断 MIME 是否为文本类（仅文本类需传入 UTF-8 编码，二进制媒体传入 UTF-8 会破坏解码器）
+     */
+    private fun isTextMime(mime: String): Boolean {
+        return mime.startsWith("text/") || mime.contains("json") || mime.contains("javascript")
+    }
+
+    /**
+     * 处理视频/大音频的 HTTP 206 Range 请求，保证流式即时播放
+     */
+    private fun handleRangeRequest(file: File, mimeType: String, rangeHeader: String): WebResourceResponse {
+        val fileLength = file.length()
+        var rangeStart: Long = 0
+        var rangeEnd: Long = fileLength - 1
+
+        try {
+            if (rangeHeader.startsWith("bytes=")) {
+                val rangeValue = rangeHeader.substring(6)
+                val parts = rangeValue.split("-")
+                if (parts.isNotEmpty() && parts[0].isNotEmpty()) {
+                    rangeStart = parts[0].toLong()
+                }
+                if (parts.size > 1 && parts[1].isNotEmpty()) {
+                    rangeEnd = parts[1].toLong()
+                }
+            }
+        } catch (e: Exception) {
+            rangeStart = 0
+            rangeEnd = fileLength - 1
+        }
+
+        if (rangeEnd >= fileLength) rangeEnd = fileLength - 1
+        val contentLength = Math.max(0, rangeEnd - rangeStart + 1)
+
+        val boundedStream = BoundedInputStream(file, rangeStart, contentLength)
+
+        val headers = mutableMapOf(
+            "Access-Control-Allow-Origin" to "*",
+            "Accept-Ranges" to "bytes",
+            "Content-Range" to "bytes $rangeStart-$rangeEnd/$fileLength",
+            "Content-Length" to contentLength.toString(),
+            "Cache-Control" to "no-cache"
+        )
+        val encoding = if (isTextMime(mimeType)) "UTF-8" else null
+        return WebResourceResponse(mimeType, encoding, 206, "Partial Content", headers, boundedStream)
+    }
+
+    /**
+     * 获取文件精准 MIME 类型
+     */
+    private fun getMimeType(fileName: String): String {
+        val ext = fileName.substringAfterLast('.', "").lowercase()
+        return when (ext) {
+            "webp" -> "image/webp"
+            "png" -> "image/png"
+            "jpg", "jpeg" -> "image/jpeg"
+            "mp4" -> "video/mp4"
+            "wav" -> "audio/wav"
+            "mp3" -> "audio/mpeg"
+            "ogg" -> "audio/ogg"
+            "txt" -> "text/plain; charset=utf-8"
+            "json" -> "application/json"
+            "css" -> "text/css"
+            "js" -> "text/javascript"
+            "svg" -> "image/svg+xml"
+            "woff", "woff2" -> "font/woff2"
+            "ttf" -> "font/ttf"
+            else -> "application/octet-stream"
+        }
+    }
