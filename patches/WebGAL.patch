@@ -0,0 +1,770 @@
+import React, { useState, useEffect, useCallback, useMemo, useRef } from 'react';
+import ReactDOM from 'react-dom';
+import { useDispatch, useSelector } from 'react-redux';
+import { RootState } from '@/store/store';
+import { setVisibility } from '@/store/GUIReducer';
+import styles from './mangaReader.module.scss';
+
+interface PageMeta {
+  file: string;
+  width: number;
+  height: number;
+}
+
+interface VolumeMeta {
+  id: number;
+  title: string;
+  pages: PageMeta[];
+}
+
+const MANGA_ROOT = './game/manga';
+
+interface BookmarkItem {
+  id: string;
+  vol: number;
+  page: number;
+  time: string;
+}
+
+// 检查是否为移动端/手机设备
+const isMobileDevice = (): boolean => {
+  if (typeof window === 'undefined') return false;
+  const ua = navigator.userAgent || '';
+  const mobileUA = /Android|iPhone|iPad|iPod|Mobile|Silk|BlackBerry|Opera Mini/i.test(ua);
+  const touchCapable = 'ontouchstart' in window || (navigator.maxTouchPoints && navigator.maxTouchPoints > 0);
+  const coarsePointer = window.matchMedia ? window.matchMedia('(pointer: coarse)').matches : false;
+  return mobileUA || (touchCapable && coarsePointer) || window.innerWidth < 768;
+};
+
+export const MangaReader: React.FC = () => {
+  const dispatch = useDispatch();
+  const isOpen = useSelector((state: RootState) => state.GUI.showMangaReader);
+  const unlockedMusic = useSelector((state: RootState) => state.userData.appreciationData.bgm);
+  const musicVolume = useSelector(({ userData }: RootState) =>
+    (userData.optionData.volumeMain * userData.optionData.bgmVolume) / 10000,
+  );
+
+  const [volumes, setVolumes] = useState<VolumeMeta[] | null>(null);
+  const [catalogError, setCatalogError] = useState(false);
+  const [historyReady, setHistoryReady] = useState(false);
+  const [currentVol, setCurrentVol] = useState<number>(1);
+  const [currentPage, setCurrentPage] = useState<number>(1);
+  // 手机端强制竖屏（无论设备旋转角度，手机漫画只要竖屏）
+  const [isPortrait, setIsPortrait] = useState<boolean>(() => {
+    if (typeof window === 'undefined') return false;
+    if (isMobileDevice()) return true;
+    return window.innerHeight > window.innerWidth || window.innerWidth < 768;
+  });
+  const [showBars, setShowBars] = useState<boolean>(true);
+  const [activeDrawer, setActiveDrawer] = useState<'none' | 'volume' | 'bookmark' | 'music'>('none');
+  const [musicTrack, setMusicTrack] = useState('');
+  const [musicError, setMusicError] = useState(false);
+  const musicPlayer = useRef<HTMLAudioElement | null>(null);
+  const attachMusicPlayer = useCallback((player: HTMLAudioElement | null) => {
+    if (!player) musicPlayer.current?.pause();
+    musicPlayer.current = player;
+  }, []);
+
+  useEffect(() => {
+    if (musicPlayer.current) musicPlayer.current.volume = musicVolume;
+  }, [musicVolume]);
+
+  useEffect(() => {
+    if (!isOpen) {
+      setMusicTrack('');
+      setMusicError(false);
+    }
+  }, [isOpen]);
+
+  const playMusic = (url: string) => {
+    const player = musicPlayer.current;
+    if (!player) return;
+    setMusicError(false);
+    setMusicTrack(url);
+    player.volume = musicVolume;
+    player.src = url;
+    void player.play().catch(() => {
+      if (player !== musicPlayer.current || player.getAttribute('src') !== url) return;
+      setMusicTrack('');
+      setMusicError(true);
+    });
+  };
+
+  const stopMusic = () => {
+    musicPlayer.current?.pause();
+    musicPlayer.current?.removeAttribute('src');
+    musicPlayer.current?.load();
+    setMusicTrack('');
+    setMusicError(false);
+  };
+  const [bookmarks, setBookmarks] = useState<BookmarkItem[]>([]);
+  const [historyPrompt, setHistoryPrompt] = useState<{ vol: number; page: number } | null>(null);
+
+  // 漫画缩放与平移状态（双指捏合缩放、双击放大、放大后拖拽漫游）
+  const [scale, setScale] = useState<number>(1.0);
+  const [translate, setTranslate] = useState<{ x: number; y: number }>({ x: 0, y: 0 });
+
+  const isPinchingRef = useRef<boolean>(false);
+  const initialPinchDistRef = useRef<number>(0);
+  const initialScaleRef = useRef<number>(1.0);
+  const lastTapTimeRef = useRef<number>(0);
+  const panStartRef = useRef<{ x: number; y: number; tx: number; ty: number } | null>(null);
+
+  const resetZoom = useCallback(() => {
+    setScale(1.0);
+    setTranslate({ x: 0, y: 0 });
+  }, []);
+
+  const audioCtxRef = useRef<AudioContext | null>(null);
+  const touchStartXRef = useRef<number | null>(null);
+  const touchStartYRef = useRef<number | null>(null);
+
+  // 监听窗口尺寸：手机端恒定锁定为竖屏
+  useEffect(() => {
+    const handleResize = () => {
+      if (isMobileDevice()) {
+        setIsPortrait(true);
+        return;
+      }
+      const portrait = window.innerHeight > window.innerWidth || window.innerWidth < 768;
+      setIsPortrait(portrait);
+    };
+    window.addEventListener('resize', handleResize);
+    window.addEventListener('orientationchange', handleResize);
+    return () => {
+      window.removeEventListener('resize', handleResize);
+      window.removeEventListener('orientationchange', handleResize);
+    };
+  }, []);
+
+  // 手机端尝试锁定物理屏幕为竖屏
+  useEffect(() => {
+    if (!isOpen) return;
+    if (isMobileDevice()) {
+      try {
+        const screenAny = window.screen as any;
+        if (screenAny?.orientation?.lock) {
+          screenAny.orientation.lock('portrait').catch(() => {});
+        }
+      } catch {}
+      try {
+        (window as any).AndroidBridge?.setOrientation('portrait');
+      } catch {}
+    }
+    return () => {
+      try {
+        const screenAny = window.screen as any;
+        if (screenAny?.orientation?.unlock) {
+          screenAny.orientation.unlock();
+        }
+      } catch {}
+      try {
+        (window as any).AndroidBridge?.setOrientation('landscape');
+      } catch {}
+    };
+  }, [isOpen]);
+
+  // Web Audio 触感提示音
+  const playClickSound = useCallback(() => {
+    try {
+      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
+      if (!audioCtxRef.current && AudioCtx) {
+        audioCtxRef.current = new AudioCtx();
+      }
+      if (audioCtxRef.current && audioCtxRef.current.state === 'suspended') {
+        audioCtxRef.current.resume();
+      }
+      if (audioCtxRef.current) {
+        const ctx = audioCtxRef.current;
+        const osc = ctx.createOscillator();
+        const gain = ctx.createGain();
+        osc.type = 'sine';
+        osc.frequency.setValueAtTime(880, ctx.currentTime);
+        osc.frequency.exponentialRampToValueAtTime(440, ctx.currentTime + 0.04);
+        gain.gain.setValueAtTime(0.06, ctx.currentTime);
+        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.04);
+        osc.connect(gain);
+        gain.connect(ctx.destination);
+        osc.start();
+        osc.stop(ctx.currentTime + 0.04);
+      }
+    } catch {
+      // 忽略音频受阻
+    }
+  }, []);
+
+  const currentVolMeta = useMemo(() => {
+    return volumes?.find((volume) => volume.id === currentVol);
+  }, [currentVol, volumes]);
+
+  const maxAvailablePage = currentVolMeta?.pages.length ?? 0;
+
+  useEffect(() => {
+    if (!isOpen || volumes) return;
+    const controller = new AbortController();
+    setCatalogError(false);
+    void fetch(`${MANGA_ROOT}/manifest.json`, { signal: controller.signal })
+      .then(async response => {
+        if (!response.ok) throw new Error(`漫画目录读取失败 (${response.status})`);
+        const catalog = await response.json();
+        if (catalog.version !== 1 || !Array.isArray(catalog.volumes) || !catalog.volumes.length) {
+          throw new Error('漫画目录格式错误');
+        }
+        setVolumes(catalog.volumes);
+      })
+      .catch(() => {
+        if (!controller.signal.aborted) setCatalogError(true);
+      });
+    return () => controller.abort();
+  }, [isOpen, volumes]);
+
+  // 从本地加载书签与续读历史（移除旧方向偏好读取）
+  useEffect(() => {
+    if (!isOpen) {
+      setHistoryReady(false);
+      return;
+    }
+    if (!volumes) return;
+    try {
+      const savedBm = localStorage.getItem('webgal_manga_bookmarks');
+      if (savedBm) {
+        setBookmarks(JSON.parse(savedBm));
+      }
+      const savedHist = localStorage.getItem('webgal_manga_history');
+      if (savedHist) {
+        const h = JSON.parse(savedHist);
+        const volume = volumes.find(v => v.id === h?.vol);
+        if (volume && Number.isInteger(h.page) && h.page >= 1 && h.page <= volume.pages.length) {
+          setHistoryPrompt(h.vol === currentVol && h.page === currentPage ? null : { vol: h.vol, page: h.page });
+        }
+      }
+    } catch (e) {
+      console.warn('Failed to load manga local state:', e);
+    } finally {
+      setHistoryReady(true);
+    }
+  }, [isOpen, volumes]);
+
+  // 翻页持久化
+  useEffect(() => {
+    if (!isOpen || !historyReady || historyPrompt || !maxAvailablePage) return;
+    try {
+      localStorage.setItem('webgal_manga_history', JSON.stringify({ vol: currentVol, page: currentPage, time: Date.now() }));
+    } catch {
+      // 忽略
+    }
+  }, [isOpen, currentVol, currentPage, historyReady, historyPrompt, maxAvailablePage]);
+
+  const closeReader = useCallback(() => {
+    playClickSound();
+    setActiveDrawer('none');
+    dispatch(setVisibility({ component: 'showMangaReader', visibility: false }));
+  }, [dispatch, playClickSound]);
+
+  const isCover = currentPage === 1;
+
+  // 单页翻页逻辑：next 逐页进入下一页，prev 逐页回上一页
+  const navigate = useCallback((direction: 'next' | 'prev') => {
+    playClickSound();
+    setHistoryPrompt(null);
+    resetZoom();
+    setCurrentPage((prev) => {
+      if (direction === 'next') {
+        return prev < maxAvailablePage ? prev + 1 : prev;
+      } else {
+        return prev > 1 ? prev - 1 : prev;
+      }
+    });
+  }, [maxAvailablePage, playClickSound, resetZoom]);
+
