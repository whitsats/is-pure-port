+      </div>,
+      document.body
+    );
+  }
+
+  const getPageUrl = (page: number) =>
+    `${MANGA_ROOT}/vol_${String(currentVol).padStart(2, '0')}/${currentVolMeta.pages[page - 1].file}`;
+
+  const goToPage = (vol: number, page: number) => {
