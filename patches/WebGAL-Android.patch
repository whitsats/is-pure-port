diff --git a/app/src/main/java/com/openwebgal/demo/StartupOpening.kt b/app/src/main/java/com/openwebgal/demo/StartupOpening.kt
new file mode 100644
index 0000000..9730d63
--- /dev/null
+++ b/app/src/main/java/com/openwebgal/demo/StartupOpening.kt
@@ -0,0 +1,271 @@
+package com.openwebgal.demo
+
+import android.content.Context
+import android.graphics.Color
+import android.media.MediaPlayer
+import android.os.SystemClock
+import android.util.Log
+import android.view.Gravity
+import android.view.View
+import android.view.accessibility.AccessibilityNodeInfo
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import android.widget.VideoView
+import java.io.File
+
+/** Owns cold-start playback before the WebView loads the title page. */
+class StartupOpening(
+    context: Context,
+    private val finished: (rendered: Boolean, interrupted: Boolean) -> Unit,
+) : FrameLayout(context) {
+    private val status = TextView(context)
+    private val actions = LinearLayout(context)
+    private val skip = action(R.string.opening_skip)
+    private val retry = action(R.string.opening_retry)
+    private var video: VideoView? = null
+    private var source: File? = null
+    private var frameRendered = false
+    private var everRendered = false
+    private var durationMs = 0
+    private var videoSize = ""
+    private var furthestMs = 0
+    private var resumeAtMs = 0
+    private var elapsedForegroundMs = 0L
+    private var foregroundStartedAt: Long? = null
+    private var lastAdvancedAt = 0L
+    private var foreground = true
+    private var closed = false
+    private var failed = false
+
+    private val startupTimeout = Runnable { playbackFailed("first frame timed out") }
+    private val progressCheck = object : Runnable {
+        override fun run() {
+            val player = video ?: return
+            if (closed || !foreground) return
+            val now = SystemClock.elapsedRealtime()
+            val position = player.currentPosition
+            if (position > furthestMs) {
+                furthestMs = position
+                lastAdvancedAt = now
+            }
+            if (furthestMs >= MIN_SKIP_MS && skip.visibility != View.VISIBLE) {
+                skip.visibility = View.VISIBLE
+            }
+            if (now - lastAdvancedAt >= STALL_TIMEOUT_MS) {
+                playbackFailed("stalled at ${furthestMs}ms")
+            } else {
+                postDelayed(this, PROGRESS_INTERVAL_MS)
+            }
+        }
+    }
+
+    init {
+        setBackgroundColor(Color.BLACK)
+        status.setTextColor(Color.WHITE)
+        status.setText(R.string.opening_loading)
+        addView(status, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT, Gravity.CENTER))
+        skip.visibility = View.GONE
+        retry.visibility = View.GONE
+        skip.accessibilityDelegate = object : View.AccessibilityDelegate() {
+            override fun onInitializeAccessibilityNodeInfo(host: View, info: AccessibilityNodeInfo) {
+                super.onInitializeAccessibilityNodeInfo(host, info)
+                info.className = "android.widget.Button"
+                // Keep the action meaningful to screen readers without exposing it as an ad-skip label.
+                info.text = null
+                info.contentDescription = resources.getText(R.string.opening_enter_title)
+            }
+        }
+        skip.setOnClickListener {
+            if (failed) {
+                complete("error-exit")
+            } else if (frameRendered && furthestMs >= MIN_SKIP_MS) {
+                complete("manual-skip")
+            }
+        }
+        retry.setOnClickListener { startAttempt() }
+        actions.addView(retry)
+        actions.addView(skip)
+        addView(actions, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT, Gravity.BOTTOM or Gravity.END))
+        setSafeMargins(0, 0, 0)
+    }
+
+    fun play(file: File?) {
+        source = file
+        startAttempt()
+    }
+
+    private fun startAttempt() {
+        if (closed) return
+        releaseVideo()
+        frameRendered = false
+        durationMs = 0
+        videoSize = ""
+        furthestMs = 0
+        resumeAtMs = 0
+        elapsedForegroundMs = 0
+        foregroundStartedAt = null
+        failed = false
+        skip.setText(R.string.opening_skip)
+        skip.visibility = View.GONE
+        retry.visibility = View.GONE
+        status.setText(R.string.opening_loading)
+        status.visibility = View.VISIBLE
+
+        val file = source
+        if (file == null) {
+            playbackFailed("bundled video could not be opened")
+            return
+        }
+
+        val player = VideoView(context).apply { isFocusable = false }
+        video = player
+        addView(player, 0, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT, Gravity.CENTER))
+        player.setOnPreparedListener { media ->
+            if (video !== player) return@setOnPreparedListener
+            durationMs = media.duration
+            videoSize = "${media.videoWidth}x${media.videoHeight}"
+            if (durationMs !in 90_000..100_000) {
+                // Leave VideoView's prepared callback before releasing its MediaPlayer.
+                post { if (video === player) playbackFailed("invalid duration ${durationMs}ms") }
+            } else {
+                if (resumeAtMs > 0) player.seekTo(resumeAtMs)
+                if (foreground) player.start()
+            }
+        }
+        player.setOnInfoListener { _, what, _ ->
+            if (video !== player || what != MediaPlayer.MEDIA_INFO_VIDEO_RENDERING_START) {
+                false
+            } else {
+                if (!frameRendered) {
+                    frameRendered = true
+                    everRendered = true
+                    status.visibility = View.GONE
+                    removeCallbacks(startupTimeout)
+                    Log.i(TAG, "First opening frame rendered: ${file.name}, $videoSize, duration=${durationMs}ms")
+                }
+                watchProgress()
+                true
+            }
+        }
+        player.setOnCompletionListener {
+            if (video !== player) return@setOnCompletionListener
+            val elapsed = foregroundPlaybackTime()
+            // Some devices report completion before any meaningful progress. Ignore that as an EOF.
+            if (frameRendered && furthestMs >= durationMs - END_POSITION_TOLERANCE_MS &&
+                elapsed >= durationMs - END_TIME_TOLERANCE_MS) {
+                Log.i(TAG, "Opening reached its end: ${furthestMs}/${durationMs}ms")
+                complete("end-of-video")
+            } else {
+                playbackFailed("premature completion at ${furthestMs}/${durationMs}ms after ${elapsed}ms")
+            }
+        }
+        player.setOnErrorListener { _, what, extra ->
+            if (video === player) playbackFailed("decoder error $what/$extra")
+            true
+        }
+        player.setVideoPath(file.path)
+        scheduleStartupTimeout()
+    }
+
+    private fun action(label: Int): TextView {
+        val density = resources.displayMetrics.density
+        return TextView(context).apply {
+            setText(label)
+            setTextColor(0xCCFFFFFF.toInt())
+            textSize = 14f
+            setShadowLayer(5 * density, 0f, density, Color.BLACK)
+            minimumHeight = (48 * density).toInt()
+            val padding = (12 * density).toInt()
+            setPadding(padding, 0, padding, 0)
+            gravity = Gravity.CENTER
+        }
+    }
+
+    fun setSafeMargins(left: Int, right: Int, bottom: Int) {
+        val margin = (12 * resources.displayMetrics.density).toInt()
+        val params = actions.layoutParams as LayoutParams
+        params.leftMargin = left + margin
+        params.rightMargin = right + margin
+        params.bottomMargin = bottom + margin
+        actions.layoutParams = params
+    }
+
+    fun pauseOpening() {
+        foreground = false
+        elapsedForegroundMs = foregroundPlaybackTime()
+        foregroundStartedAt = null
+        removeCallbacks(startupTimeout)
+        removeCallbacks(progressCheck)
+        video?.let {
+            resumeAtMs = it.currentPosition
+            it.pause()
+        }
+    }
+
+    fun resumeOpening() {
+        foreground = true
+        if (closed || failed) return
+        video?.start()
+        if (frameRendered) watchProgress() else scheduleStartupTimeout()
+    }
+
+    private fun foregroundPlaybackTime(): Long =
+        elapsedForegroundMs + (foregroundStartedAt?.let { SystemClock.elapsedRealtime() - it } ?: 0L)
+
+    private fun watchProgress() {
+        if (!foreground || closed || failed) return
+        val now = SystemClock.elapsedRealtime()
+        if (foregroundStartedAt == null) foregroundStartedAt = now
+        lastAdvancedAt = now
+        removeCallbacks(progressCheck)
+        post(progressCheck)
+    }
+
+    private fun scheduleStartupTimeout() {
+        removeCallbacks(startupTimeout)
+        if (foreground && video != null) postDelayed(startupTimeout, STALL_TIMEOUT_MS)
+    }
+
+    private fun playbackFailed(reason: String) {
+        if (closed || failed) return
+        Log.w(TAG, "Opening playback failed: $reason")
+        releaseVideo()
+        failed = true
+        status.setText(R.string.opening_unavailable)
+        status.visibility = View.VISIBLE
+        skip.setText(R.string.opening_enter_title)
+        skip.visibility = View.VISIBLE
+        retry.visibility = if (source == null) View.GONE else View.VISIBLE
+    }
+
+    private fun complete(reason: String) {
+        if (closed) return
+        Log.i(TAG, "Leaving opening: $reason, position=${furthestMs}ms, foreground=${foregroundPlaybackTime()}ms")
+        close()
+        finished(everRendered, failed)
+    }
+
+    private fun releaseVideo() {
+        removeCallbacks(startupTimeout)
+        removeCallbacks(progressCheck)
+        val previous = video ?: return
+        video = null
+        previous.stopPlayback()
+        removeView(previous)
+    }
+
+    fun close() {
+        closed = true
+        releaseVideo()
+    }
+
+    companion object {
+        private const val TAG = "StartupOpening"
+        private const val MIN_SKIP_MS = 4_000
+        private const val STALL_TIMEOUT_MS = 18_000L
+        private const val PROGRESS_INTERVAL_MS = 250L
+        private const val END_POSITION_TOLERANCE_MS = 2_000
+        private const val END_TIME_TOLERANCE_MS = 3_000L
+    }
+}
