+                  >
+                    ✕ 删除
+                  </div>
+                </div>
+              ))
+            )}
+          </div>
+        </div>
+        {activeDrawer === 'music' && (
+          <section className={`${styles.drawer} ${styles.drawerTop}`} aria-label="阅读音乐">
+            <div className={styles.drawerHeader}>
+              <div className={styles.drawerHeaderTitle}>阅读音乐</div>
+              <button type="button" className={styles.drawerCloseBtn} onClick={() => setActiveDrawer('none')}>
+                关闭
+              </button>
+            </div>
+            <div className={styles.drawerBodyBookmark}>
+              {unlockedMusic.length === 0 ? (
+                <p className={styles.emptyDrawerTip}>在剧情中解锁的 BGM 会出现在这里。</p>
+              ) : (
+                <>
+                  <button type="button" className={styles.track} aria-pressed={!musicTrack} onClick={stopMusic}>
