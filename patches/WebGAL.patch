+                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
+              </svg>
+              <span>返回</span>
+            </button>
+
+            <button
+              className={`${styles.wgBtn} ${activeDrawer === 'volume' ? styles.activeBtn : ''}`}
+              onClick={() => {
+                playClickSound();
+                setActiveDrawer((d) => (d === 'volume' ? 'none' : 'volume'));
+              }}
+              title="展开上方卷目菜单"
+            >
+              <svg viewBox="0 0 24 24">
+                <path d="M3 6h18v2H3V6m0 5h18v2H3v-2m0 5h18v2H3v-2Z" />
+              </svg>
+              <span>卷目 ▾</span>
+            </button>
+          </div>
+
+            <div
+              className={styles.titleBox}
+              onClick={() => {
+                playClickSound();
+                setActiveDrawer((d) => (d === 'volume' ? 'none' : 'volume'));
+              }}
