diff --git a/packages/webgal/src/UI/Title/openingLoop.module.scss b/packages/webgal/src/UI/Title/openingLoop.module.scss
new file mode 100644
index 0000000..b7d77dc
--- /dev/null
+++ b/packages/webgal/src/UI/Title/openingLoop.module.scss
@@ -0,0 +1,139 @@
+.openingLoop_main {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  /* 压过标题(13)、鉴赏(14)、菜单(16)与语言选择(20)，但仍低于紧急回避页(256) */
+  z-index: 30;
+  pointer-events: auto;
+  background: #000;
+  overflow: hidden;
+}
+
+.openingLoop_video {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  background: #000;
+}
+
+.openingLoop_mutedHint {
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 40px;
+  text-align: center;
+  color: rgba(255, 255, 255, 0.72);
+  font-size: 30px;
+  letter-spacing: 0.08em;
+  text-shadow: 0 0 12px rgba(0, 0, 0, 0.85);
+  pointer-events: none;
+}
+
+.openingLoop_skipHint {
+  position: absolute;
+  right: 48px;
+  bottom: 40px;
+  color: rgba(255, 255, 255, 0.5);
+  font-size: 30px;
+  letter-spacing: 0.12em;
+  text-shadow: 0 0 12px rgba(0, 0, 0, 0.8);
+  animation: openingLoopHintFade 6s ease-out forwards;
+  pointer-events: none;
+}
+
+@keyframes openingLoopHintFade {
+  0% {
+    opacity: 0;
+  }
+  10%,
+  55% {
+    opacity: 1;
+  }
+  100% {
+    opacity: 0;
+  }
+}
+
+.openingLoop_blocked {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
