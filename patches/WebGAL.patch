+      try {
+        localStorage.setItem('webgal_manga_bookmarks', JSON.stringify(updated));
+      } catch {
+        // 忽略
+      }
+      return updated;
+    });
+  }, [isBookmarked, currentVol, currentPage, playClickSound]);
+
+  const deleteBookmark = useCallback((id: string, e: React.MouseEvent) => {
