+                  }}
+                >
+                  <div>
+                    <div className={styles.bmTitle}>第 {bm.vol} 卷 · 第 {bm.page} 页</div>
+                    <div className={styles.bmTime}>{bm.time}</div>
+                  </div>
+                  <div
+                    className={styles.bmDelBtn}
+                    onClick={(e) => deleteBookmark(bm.id, e)}
