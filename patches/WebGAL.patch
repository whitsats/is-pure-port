diff --git a/packages/webgal/src/Core/util/coreInitialFunction/appreciationPreset.ts b/packages/webgal/src/Core/util/coreInitialFunction/appreciationPreset.ts
new file mode 100644
index 0000000..dcca1b6
--- /dev/null
+++ b/packages/webgal/src/Core/util/coreInitialFunction/appreciationPreset.ts
@@ -0,0 +1,94 @@
+/**
+ * @file 鉴赏数据批量预置
+ *
+ * 原版游戏的 CG／影片鉴赏是“玩过的内容才解锁”，移植工程里所有素材都已经随游戏发布，
+ * 因此允许用一份数据文件把鉴赏条目一次性接进 WebGAL 原生鉴赏页（Extra），
+ * 而不是另做一套画廊界面。
+ *
+ * 在 game/config.txt 里用 Appreciation_Preset 指定数据文件（相对于 game/），未指定时不读取，
+ * 也不会产生请求，不影响其他工程：
+ *
+ *   Appreciation_Preset:appreciation.json;
+ *
+ * 数据文件格式（文件放在 game/ 下）：
+ *
+ *   {
+ *     "cg": [{ "file": "EV_0000.png", "name": "EV_0000", "order": 0, "thumb": "thumb/EV_0000.webp" }],
+ *     "bgm": [{ "file": "s_Title.mp3", "name": "标题曲" }]
+ *   }
+ *
+ * thumb 可选：鉴赏列表里显示的小图；不填就直接用 file 原图。
+ *
+ * file 是 game/background/（CG）或 game/bgm/（BGM）下的文件名，和 WebGAL 的
+ * unlockCg / unlockBgm 指令一样经 assetSetter 补全路径；已存在的条目按 url 去重。
+ */
+import axios from 'axios';
+import { webgalStore } from '@/store/store';
+import { unlockBgmInUserData, unlockCgInUserData } from '@/store/userDataReducer';
+import { setStorageAsync } from '@/Core/controller/storage/storageController';
+import { assetSetter, fileType } from '@/Core/util/gameAssetsAccess/assetSetter';
+import { logger } from '@/Core/util/logger';
+
+interface IAppreciationPresetItem {
+  file?: string;
+  name?: string;
+  series?: string;
+  order?: number;
+  thumb?: string;
+}
+
+interface IAppreciationPreset {
+  cg?: IAppreciationPresetItem[];
+  bgm?: IAppreciationPresetItem[];
+}
+
+export const loadAppreciationPreset = async (presetPath?: string): Promise<void> => {
+  if (!presetPath) return;
+  const dispatch = webgalStore.dispatch;
+  try {
+    // 用 validateStatus 自己判断，文件缺失时只记一条日志，不抛异常
+    const response = await axios.get(`./game/${presetPath}`, { validateStatus: () => true });
+    if (response.status !== 200) {
+      logger.warn(`鉴赏预置文件读取失败：${presetPath}（HTTP ${response.status}），跳过预置`);
+      return;
+    }
+    const preset = (response.data ?? {}) as IAppreciationPreset;
+    const cgList = Array.isArray(preset.cg) ? preset.cg : [];
+    const bgmList = Array.isArray(preset.bgm) ? preset.bgm : [];
+    if (cgList.length === 0 && bgmList.length === 0) return;
+
+    cgList.forEach((item, index) => {
+      if (!item || typeof item.file !== 'string' || item.file === '') return;
+      dispatch(
+        unlockCgInUserData({
+          name: item.name ?? item.file,
+          url: assetSetter(item.file, fileType.background),
+          series: item.series ?? 'default',
+          order: typeof item.order === 'number' ? item.order : index,
+          thumb:
+            typeof item.thumb === 'string' && item.thumb !== ''
+              ? assetSetter(item.thumb, fileType.background)
+              : undefined,
+        }),
+      );
+    });
+    bgmList.forEach((item, index) => {
+      if (!item || typeof item.file !== 'string' || item.file === '') return;
+      dispatch(
+        unlockBgmInUserData({
+          name: item.name ?? item.file,
+          url: assetSetter(item.file, fileType.bgm),
+          series: item.series ?? 'default',
+          order: typeof item.order === 'number' ? item.order : index,
+        }),
+      );
+    });
+
+    // 直接写入本地存储：GETSTORAGE 的防抖读盘可能在启动阶段把旧数据恢复回来，
+    // 预置必须落盘，之后任何一次 getStorage() 读到的都是带预置的版本。
+    await setStorageAsync();
+    logger.info(`鉴赏预置已写入：CG ${cgList.length} 项，BGM ${bgmList.length} 项（${presetPath}）`);
+  } catch (error) {
+    logger.warn('鉴赏预置读取失败，跳过预置', error);
+  }
+};
diff --git a/packages/webgal/src/Core/util/unlockCgFromAsset.ts b/packages/webgal/src/Core/util/unlockCgFromAsset.ts
