+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 16px;
+  color: #f7f7f7;
+  font-size: 16px;
+  background: #181516;
+}
+
+.openingStatus button {
+  min-height: 44px;
+  padding: 0 14px;
+  color: inherit;
+  font: inherit;
+  background: #2b2527;
+  border: 1px solid #655057;
+  border-radius: 6px;
+}
+
+.androidSkip {
