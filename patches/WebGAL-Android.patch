+        val target = File(cacheDir, "$cacheName.mp4")
+        if (!target.isFile || target.length() != expectedLength) {
+            val temporary = File(cacheDir, "$cacheName.part")
+            assets.open(assetPath).use { source ->
+                temporary.outputStream().use { destination -> source.copyTo(destination) }
+            }
+            check(temporary.length() == expectedLength) { "内置片头不完整" }
+            check(temporary.renameTo(target)) { "无法准备内置片头" }
+        }
+        return target
+    }
 
