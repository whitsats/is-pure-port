+import { defineConfig, mergeConfig } from 'vite';
+import { resolve } from 'path';
+import baseConfig from './vite.config';
+
+// 分支扫描：每个 worker 用 扫描分支/w<编号>/public 这份场景副本（vocal/background 是目录联接，
+// 指回 新游戏打盘版/public）。扫描只改副本里的 start.txt，不动 4203 的现行样片。
+const worker = process.env.SCAN_WORKER ?? '0';
+
+export default mergeConfig(baseConfig, defineConfig({
+  publicDir: resolve(__dirname, `../../../scan/w${worker}/public`),
+  plugins: [{
+    name: 'branch-scan-log-invalid-url',
+    configureServer(server) {
+      server.middlewares.use((request, response, next) => {
+        try {
+          decodeURI(request.url ?? '');
+        } catch {
+          console.error(`[branch-scan] invalid URL: ${request.url}`);
+          response.statusCode = 404;
+          response.end('Malformed non-story animation URL omitted during branch scan');
+          return;
+        }
+        next();
+      });
+    },
+  }],
+}));
