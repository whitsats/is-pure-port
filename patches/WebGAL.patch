+            >
+              <svg viewBox="0 0 24 24">
+                <path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2Z" />
+              </svg>
+              <span className={styles.btnLabelDesktop}>{isBookmarked ? '已书签' : '存书签'}</span>
+            </button>
+
+            <button
+              className={`${styles.wgBtn} ${activeDrawer === 'bookmark' ? styles.activeBtn : ''}`}
+              onClick={() => {
+                playClickSound();
+                setActiveDrawer((d) => (d === 'bookmark' ? 'none' : 'bookmark'));
+              }}
+              title="查看已存书签"
+            >
+              <svg viewBox="0 0 24 24">
+                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" />
+              </svg>
+              <span className={styles.btnLabelDesktop}>书签夹</span>
+            </button>
