+    grid-row: 2;
+    grid-column: 1 / -1;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 8px;
+    padding-inline: 7px;
+    text-align: left;
+  }
+  .mainTitle { font-size: 13px; }
+}
diff --git a/packages/webgal/src/UI/Menu/DiscStatus/DiscStatus.tsx b/packages/webgal/src/UI/Menu/DiscStatus/DiscStatus.tsx
new file mode 100644
index 0000000..4eb7c30
--- /dev/null
+++ b/packages/webgal/src/UI/Menu/DiscStatus/DiscStatus.tsx
@@ -0,0 +1,68 @@
+import { useStageState } from '@/hooks/useStageState';
+import { useDispatch } from 'react-redux';
+import { setVisibility } from '@/store/GUIReducer';
+import useSoundEffect from '@/hooks/useSoundEffect';
+import styles from './discStatus.module.scss';
+
+const characters = [
+  ['mac_6026', '伊织', 'CHR_0416.png'],
+  ['mac_6027', '季子', 'CHR_1214.png'],
+  ['mac_6028', '泉', 'CHR_1718.png'],
+  ['mac_6029', '蓝子', 'CHR_0014.png'],
+] as const;
+
+const traits = [
+  ['mac_602a', '自信', '#deb47b'],
+  ['mac_602c', '别扭度', '#d99b9a'],
+  ['mac_602b', '自制心', '#9bb69a'],
+] as const;
+
+export function DiscStatus() {
+  const { GameVar, bgName } = useStageState();
+  const dispatch = useDispatch();
+  const { playSeClick } = useSoundEffect();
+  return (
+    <div className={styles.page}>
+      {bgName && <img className={styles.backdrop} src={bgName} alt="" />}
+      <section className={styles.sheet} aria-label="游戏状态">
+        <header className={styles.header}>
+          <h1>游戏状态</h1>
+          <button type="button" onClick={() => {
+            playSeClick();
+            dispatch(setVisibility({ component: 'showMenuPanel', visibility: false }));
+          }}>返回剧情</button>
+        </header>
+        <div className={styles.columns}>
+          <section aria-labelledby="disc-affection-heading">
+            <h2 id="disc-affection-heading">角色好感度</h2>
+            <dl className={styles.characters}>
+              {characters.map(([key, label, portrait]) => (
+                <div className={styles.character} key={key}>
+                  <dt><img src={`./game/figure/disc-hd/${portrait}`} alt="" /><span>{label}</span></dt>
+                  <dd data-stat={key}>{GameVar[key] ?? '—'}</dd>
+                </div>
+              ))}
+            </dl>
+          </section>
+          <section aria-labelledby="disc-traits-heading">
+            <h2 id="disc-traits-heading">性格数值</h2>
+            <div>
+              {traits.map(([key, label, color]) => {
+                const raw = GameVar[key];
+                const fill = typeof raw === 'number' ? Math.min(40, Math.max(0, raw)) : 0;
+                return (
+                  <div className={styles.trait} key={key}>
+                    <div className={styles.row}>
+                      <span>{label}</span><strong data-stat={key}>{raw ?? '—'}</strong>
+                    </div>
+                    <meter min={0} max={40} value={fill} aria-label={label} style={{ color }} />
+                  </div>
+                );
+              })}
+            </div>
+          </section>
+        </div>
+      </section>
+    </div>
+  );
+}
