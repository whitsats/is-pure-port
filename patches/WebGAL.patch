+            >
+              <div className={styles.mainTitle}>{currentVolMeta.title}</div>
+              <div className={styles.subTitle}>
+                第 {currentPage} 页 {isCover ? '(封面)' : ''} / 共 {maxAvailablePage} 页
+              </div>
+            </div>
+
+          {/* 右侧：书签功能，移除方向切换和单双页切换 */}
+          <div className={styles.topRight}>
