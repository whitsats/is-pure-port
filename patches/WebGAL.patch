diff --git a/packages/webgal/src/UI/Title/OpeningLoop.tsx b/packages/webgal/src/UI/Title/OpeningLoop.tsx
new file mode 100644
index 0000000..cbdc704
--- /dev/null
+++ b/packages/webgal/src/UI/Title/OpeningLoop.tsx
@@ -0,0 +1,385 @@
+import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { useDispatch, useSelector } from 'react-redux';
+import axios from 'axios';
+import { RootState } from '@/store/store';
+import { setOpeningVideo, setVisibility } from '@/store/GUIReducer';
+import { WebgalParser } from '@/Core/parser/sceneParser';
+import { assetSetter, fileType } from '@/Core/util/gameAssetsAccess/assetSetter';
+import { unlockCgFromAsset } from '@/Core/util/unlockCgFromAsset';
+import { logger } from '@/Core/util/logger';
+import styles from './openingLoop.module.scss';
+
+/** 标题页停留的默认时长（毫秒） */
+const DEFAULT_HOLD_TIME = 15000;
+
+type OpeningPhase = 'video' | 'hold';
+
+interface OpeningConfig {
+  video: string;
+  holdTime: number;
+}
+
+declare global {
+  interface Window {
+    /** index.html 在解析阶段读取 config.txt 后写入，用于首帧就盖住标题界面 */
+    __WEBGAL_OPENING_VIDEO__?: string;
+  }
+}
+
+/**
+ * 标题界面的片头循环（原版开屏行为）。
+ *
+ * 打开游戏直接播放片头 → 片头结束后停在标题界面（背景由 Title_img 指定）→
+ * 停留 Opening_hold_time 毫秒 → 再次播放片头，如此循环，直到玩家开始游戏。
+ *
+ * 由 game/config.txt 配置，未配置 Opening_video 时完全不渲染，不影响其他工程：
+ *   Opening_video:MV_OP01.mp4;       片头文件，放在 game/video/ 下
+ *   Opening_hold_time:15000;         标题界面停留时间（毫秒）
+ *
+ * 这里直接读取 config.txt，而不是取 userData.globalGameVar：引擎会把配置写进
+ * 本地存储并在后续 getStorage() 时整份恢复，改配置或改文件名后会读到旧值。
+ */
+export default function OpeningLoop() {
+  const dispatch = useDispatch();
+  const android = (window as Window & { AndroidBridge?: { getStartupOpeningResult?: () => string } }).AndroidBridge;
+  const startupOpening = android?.getStartupOpeningResult?.() ?? '';
+  const gameConfigReady = useSelector((state: RootState) => Boolean(state.userData.gameConfigInit.Game_key));
+  const showTitle = useSelector((state: RootState) => state.GUI.showTitle);
+  const panelOpen = useSelector(
+    (state: RootState) =>
+      state.GUI.showMenuPanel ||
+      state.GUI.showBacklog ||
+      state.GUI.showGlobalDialog ||
+      state.GUI.showExtra ||
+      state.GUI.showMangaReader ||
+      state.GUI.showPanicOverlay,
+  );
+  const volumeMain = useSelector((state: RootState) => state.userData.optionData?.volumeMain ?? 100);
+  const volumeBgm = useSelector((state: RootState) => state.userData.optionData?.bgmVolume ?? 100);
+
+  // index.html 里的内联脚本会在 React 挂载前读到片头配置，首帧就能直接起片头，
+  // 不必等这里的 axios；否则标题菜单会以默认样式先露出来半秒。
+  const earlyVideo = typeof window === 'undefined' ? undefined : window.__WEBGAL_OPENING_VIDEO__;
+  // 落地页在 index.html 里默认 display:none，读到片头配置后才决定是否显示；
+  // 这里用计算样式判断，避免“已隐藏但没拿到文件名”的空档露出默认样式标题。
+  const landingElement =
+    typeof document === 'undefined' ? null : (document.querySelector('.html-body__title-enter') as HTMLElement | null);
+  const landingHiddenEarly = !!landingElement && getComputedStyle(landingElement).display === 'none';
+
+  const [opening, setOpening] = useState<OpeningConfig | null>(
+    earlyVideo ? { video: earlyVideo, holdTime: DEFAULT_HOLD_TIME } : null,
+  );
+  const [pendingCover, setPendingCover] = useState(!startupOpening && !earlyVideo && landingHiddenEarly);
+  const videoRef = useRef<HTMLVideoElement | null>(null);
+  const openedCgUnlockedRef = useRef(false);
+  // 首次挂载就是开机：有片头时直接进入播放阶段，避免标题菜单多露一帧
+  const [phase, setPhase] = useState<OpeningPhase>(startupOpening ? 'hold' : 'video');
+  const [autoplayBlocked, setAutoplayBlocked] = useState(false);
+  const [mutedByPolicy, setMutedByPolicy] = useState(false);
+  const [loaded, setLoaded] = useState(false);
+  const [failed, setFailed] = useState(false);
+  const [allowLoop, setAllowLoop] = useState(!startupOpening || startupOpening === 'played');
+
+  const enabled = opening !== null;
+  const holdTime = opening?.holdTime ?? DEFAULT_HOLD_TIME;
+  const videoUrl = opening ? assetSetter(opening.video, fileType.video) : '';
+  const showOpening = showTitle && !panelOpen && (pendingCover || (enabled && phase === 'video'));
+
+  useLayoutEffect(() => {
+    dispatch(setVisibility({ component: 'titleOpeningActive', visibility: showOpening }));
+  }, [dispatch, showOpening]);
+
+  /** 读取片头配置（停留时长等）；片头文件名已由 index.html 提前给出 */
+  useEffect(() => {
+    let cancelled = false;
+    axios
+      .get('./game/config.txt')
+      .then((response) => {
+        if (cancelled) return;
+        const config = WebgalParser.parseConfig(String(response.data));
+        const video = String(config.find((item) => item.command === 'Opening_video')?.args?.[0] ?? '').trim();
+        dispatch(setOpeningVideo(video));
+        if (!video) {
+          setOpening(null);
+          setPendingCover(false);
+          return;
+        }
+        const holdTimeValue = Number(config.find((item) => item.command === 'Opening_hold_time')?.args?.[0]);
+        setOpening({
+          video,
+          holdTime: Number.isFinite(holdTimeValue) && holdTimeValue > 0 ? holdTimeValue : DEFAULT_HOLD_TIME,
+        });
+        setPendingCover(false);
+      })
+      .catch(() => {
+        if (!cancelled) {
+          setOpening(null);
+          setPendingCover(false);
+        }
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [dispatch]);
+
+  /**
+   * 跳过 WebGAL 自带的“PRESS THE SCREEN TO START”落地页与 Logo 过场：
+   * 片头循环开启时，打开页面就直接进入片头。
+   */
+  useEffect(() => {
+    if (!enabled) return;
+    const landing = document.querySelector('.html-body__title-enter') as HTMLElement | null;
+    if (landing) {
+      landing.style.pointerEvents = 'none';
+      landing.style.transition = 'none';
+      landing.style.opacity = '0';
+      landing.style.display = 'none';
+    }
+    dispatch(setVisibility({ component: 'isShowLogo', visibility: false }));
+  }, [enabled, dispatch]);
+
+  useEffect(() => {
+    if (!showTitle || panelOpen) setPhase('hold');
+  }, [showTitle, panelOpen]);
+
+  const handleMediaFailure = useCallback(() => {
+    if (!showOpening || failed) return;
+    logger.warn(`片头无法播放：${videoUrl}`);
+    setFailed(true);
+  }, [failed, showOpening, videoUrl]);
+
+  /** 播放片头：先尝试带声音播放，被策略拦截时静音起播，保证画面立刻在走 */
+  useLayoutEffect(() => {
+    if (!showOpening || !videoUrl || failed) return;
+    const video = videoRef.current;
+    if (!video) return;
+    let disposed = false;
+    setLoaded(false);
+    setAutoplayBlocked(false);
+    setMutedByPolicy(false);
+    video.volume = Math.min(1, Math.max(0, volumeMain / 100) * Math.max(0, volumeBgm / 100));
+    video.muted = false;
+    video
+      .play()
+      .then(() => {
+        if (!disposed) {
+          setMutedByPolicy(false);
+          setAutoplayBlocked(false);
+        }
+      })
+      .catch((error) => {
+        if (disposed) return;
+        if (error.name !== 'NotAllowedError') throw error;
+        // 浏览器在用户交互前通常不允许带声音自动播放：改为静音起播，画面不中断，
+        // 玩家任意一次点击/按键再恢复声音，且不会因此跳过片头。
+        video.muted = true;
+        return video.play().then(() => {
+          if (!disposed) {
+            setMutedByPolicy(true);
+            setAutoplayBlocked(false);
+          }
+        });
+      })
+      .catch((error) => {
+        if (!disposed) {
+          if (error.name === 'NotAllowedError') setAutoplayBlocked(true);
+          else handleMediaFailure();
+        }
+      });
+    return () => {
+      disposed = true;
+      video.pause();
+    };
+    // 音量单独同步，避免调节音量时重新开始片头
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [showOpening, videoUrl, failed, handleMediaFailure]);
+
+  useEffect(() => {
+    if (!showOpening || !videoUrl || loaded || failed || autoplayBlocked) return;
+    const timeout = window.setTimeout(handleMediaFailure, 15000);
+    return () => window.clearTimeout(timeout);
+  }, [showOpening, videoUrl, loaded, failed, autoplayBlocked, handleMediaFailure]);
+
+  /** 音量设置变化时同步到片头 */
+  useEffect(() => {
+    const video = videoRef.current;
+    if (!video) return;
+    video.volume = Math.min(1, Math.max(0, volumeMain / 100) * Math.max(0, volumeBgm / 100));
+  }, [volumeMain, volumeBgm, phase]);
+
+  /** 静音起播后，键盘操作也要能恢复声音 */
+  useEffect(() => {
+    if (!mutedByPolicy) return;
+    const unmute = () => {
+      const video = videoRef.current;
+      if (video && video.muted) {
+        video.muted = false;
+        setMutedByPolicy(false);
+      }
+    };
+    window.addEventListener('keydown', unmute);
+    return () => window.removeEventListener('keydown', unmute);
+  }, [mutedByPolicy]);
+
+  /** 标题界面停留计时，到时继续播放片头 */
+  useEffect(() => {
+    if (!allowLoop || !enabled || !showTitle || phase !== 'hold' || panelOpen || failed) return;
+    const timer = window.setTimeout(() => setPhase('video'), holdTime);
+    return () => window.clearTimeout(timer);
+  }, [allowLoop, enabled, showTitle, phase, panelOpen, holdTime, failed]);
+
+  /** 标题界面点“片头回放”：用同一条视频重放，不复制文件；重放结束后照常回到标题停留 */
+  useEffect(() => {
+    if (!enabled) return;
+    const replay = () => {
+      if (!showTitle || panelOpen) return;
+      setAllowLoop(true);
+      if (failed) {
+        setFailed(false);
+      }
+      const video = videoRef.current;
+      if (video && phase === 'video') {
+        video.currentTime = 0;
+        video.muted = false;
+        video.play().catch((error) => logger.warn('片头重放失败', error));
+        return;
+      }
+      setPhase('video');
+    };
+    window.addEventListener('webgal:replay-opening', replay);
+    return () => window.removeEventListener('webgal:replay-opening', replay);
+  }, [enabled, showTitle, panelOpen, phase, failed]);
+
+  const unlockOpeningCg = useCallback(() => {
+    if (openedCgUnlockedRef.current) return;
+    openedCgUnlockedRef.current = true;
+    unlockCgFromAsset('EV_0134.png', 'EV_OP01「オープニング」', 134, 'thumb/EV_0134.webp');
+  }, []);
+
+  useEffect(() => {
+    if (!startupOpening) return;
+    dispatch(setVisibility({ component: 'isEnterGame', visibility: true }));
+  }, [dispatch, startupOpening]);
+
+  useEffect(() => {
+    if ((startupOpening === 'played' || startupOpening === 'interrupted') && gameConfigReady) unlockOpeningCg();
+  }, [startupOpening, gameConfigReady, unlockOpeningCg]);
+
+  const endOpening = useCallback(() => {
+    setPhase('hold');
+    dispatch(setVisibility({ component: 'isEnterGame', visibility: true }));
+  }, [dispatch]);
+
+  const handlePlayByClick = useCallback(() => {
+    const video = videoRef.current;
+    if (!video) return;
+    video.muted = false;
+    video
+      .play()
+      .then(() => {
+        setAutoplayBlocked(false);
+        setMutedByPolicy(false);
+      })
+      .catch((error) => logger.warn('片头播放失败', error));
+  }, []);
+
+  /** 片头画面的点击：静音时只恢复声音，不跳过；有声时点击才跳过片头 */
+  const handleOpeningClick = useCallback(() => {
+    const video = videoRef.current;
+    if (!loaded) return;
+    if (video && video.muted) {
+      video.muted = false;
+      setMutedByPolicy(false);
+      return;
+    }
+    if (!android) endOpening();
+  }, [android, endOpening, loaded]);
+
+  if (!enabled) {
+    // 已知是片头工程、但配置还没读完：先盖一块黑场，避免标题以默认样式闪出来
+    if (showOpening) {
+      return <div className={styles.openingLoop_main} />;
+    }
+    return null;
+  }
+
+  if (!showOpening) {
+    return null;
+  }
+
+  const player = (
+    <div className={styles.openingLoop_main} onClick={autoplayBlocked || failed ? undefined : handleOpeningClick}>
+      {!failed && <video
+        key={videoUrl}
+        ref={videoRef}
+        className={styles.openingLoop_video}
+        src={videoUrl}
+        preload="auto"
+        playsInline={true}
+        onPlaying={() => {
+          setLoaded(true);
+          unlockOpeningCg();
+        }}
+        onEnded={({ currentTarget: video }) => {
+          if (android && opening.video === 'MV_OP01_phone60.mp4' &&
+            (!Number.isFinite(video.duration) || video.duration < 90 || video.currentTime < video.duration - 2)) {
+            handleMediaFailure();
+          } else {
+            endOpening();
+          }
+        }}
+        onError={handleMediaFailure}
+      />}
+      {(failed || (!loaded && !autoplayBlocked)) && (
+        <div className={styles.openingStatus} role="status">
+          <span>{failed ? '片头播放失败' : '正在载入片头…'}</span>
+          {failed && <button type="button" onClick={() => {
+            setFailed(false);
+          }}>重试</button>}
+          <button type="button" onClick={(event) => {
+            event.stopPropagation();
+            endOpening();
+          }}>{failed ? '返回标题' : '跳过片头'}</button>
+        </div>
+      )}
+      {autoplayBlocked && (
+        <div className={styles.openingLoop_blocked}>
+          <div className={styles.openingLoop_blockedTitle}>点击开始</div>
+          <div className={styles.openingLoop_blockedHint}>浏览器限制自动播放，点击一次即可播放片头</div>
+          <div
+            className={styles.openingLoop_button}
+            onClick={(event) => {
+              event.stopPropagation();
+              handlePlayByClick();
+            }}
+          >
+            播放片头
+          </div>
+        </div>
+      )}
+      {loaded && !autoplayBlocked && mutedByPolicy && (
+        <div className={styles.openingLoop_mutedHint}>浏览器限制自动播放：片头已静音播放，点击任意处开启声音</div>
+      )}
+      {loaded && !autoplayBlocked && !mutedByPolicy && (
+        android ? (
+          <button
+            type="button"
+            className={styles.androidSkip}
+            aria-label="返回标题"
+            onClick={(event) => {
+              event.stopPropagation();
+              if (window.confirm('结束片头并返回标题？')) endOpening();
+            }}
+          >
+            <span aria-hidden="true">跳过片头</span>
+          </button>
+        ) : <div className={styles.openingLoop_skipHint}>点击跳过片头</div>
+      )}
+    </div>
+  );
+  const viewportHost = opening.video === 'MV_OP01_phone60.mp4'
+    ? document.getElementById('html-body__viewport-video')
+    : null;
+  return viewportHost ? createPortal(player, viewportHost) : player;
+}
