@@ -0,0 +1,40 @@
+import { useEffect, useState } from 'react';
+import { createPortal } from 'react-dom';
+import styles from './collectionNotice.module.scss';
+
+interface UnlockNotice {
+  kind: 'cg' | 'bgm';
+  name: string;
+}
+
+export default function CollectionNotice() {
+  const [notices, setNotices] = useState<UnlockNotice[]>([]);
+  const current = notices[0];
+
+  useEffect(() => {
+    const addNotice = (event: Event) => {
+      const { detail } = event as CustomEvent<UnlockNotice>;
+      setNotices((queue) => [...queue, detail]);
+    };
+    window.addEventListener('webgal:collection-unlocked', addNotice);
+    return () => window.removeEventListener('webgal:collection-unlocked', addNotice);
+  }, []);
+
+  useEffect(() => {
+    if (!current) return;
+    const timer = window.setTimeout(() => setNotices((queue) => queue.slice(1)), 3200);
+    return () => window.clearTimeout(timer);
+  }, [current]);
+
+  return createPortal(
+    <div className={styles.host} role="status">
+      {current && (
+        <div className={styles.notice} key={current.name}>
+          <strong>{current.kind === 'cg' ? 'CG 已收录' : '音乐已收录'}</strong>
+          <span>{current.name}</span>
+        </div>
+      )}
+    </div>,
+    document.body,
+  );
+}
