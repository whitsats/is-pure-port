+    /**
+     * 将用户选择的 game.zip 自动解压至应用私有沙盒 (files/game)
+     */
+    private fun extractZipAndApply(zipUri: Uri) {
+        val progressDialog = ProgressDialog(this).apply {
+            setTitle("📦 正在解压高清游戏素材")
+            setMessage("正在初始化解压，请保持应用处于前台...")
+            setProgressStyle(ProgressDialog.STYLE_HORIZONTAL)
+            isIndeterminate = false
+            max = 16592
+            progress = 0
+            setCancelable(false)
+            show()
+        }
+
+        Thread {
+            try {
+                val inputStream = contentResolver.openInputStream(zipUri)
+                    ?: throw IllegalStateException("无法读取选中的压缩包")
+                val zipIn = ZipInputStream(BufferedInputStream(inputStream, 256 * 1024))
+                val targetBase = File(getExternalFilesDir(null), "game")
+                targetBase.mkdirs()
+
+                val buffer = ByteArray(256 * 1024)
+                var count = 0
+                var entry: ZipEntry? = zipIn.nextEntry
+
+                while (entry != null) {
+                    val entryName = entry.name
+                    // 如果 zip 顶层包含 game/...，去除该前缀平铺在 targetBase 下
+                    val normalizedName = if (entryName.startsWith("game/")) {
+                        entryName.substring(5)
+                    } else if (entryName.startsWith("game\\")) {
+                        entryName.substring(5)
+                    } else {
+                        entryName
+                    }
+
+                    if (normalizedName.isNotEmpty()) {
+                        val outFile = File(targetBase, normalizedName)
+                        if (!outFile.canonicalPath.startsWith(targetBase.canonicalPath)) {
+                            throw SecurityException("非法的压缩包路径: $entryName")
+                        }
+
+                        if (entry.isDirectory) {
+                            outFile.mkdirs()
+                        } else {
+                            outFile.parentFile?.mkdirs()
+                            FileOutputStream(outFile).use { fos ->
+                                var len: Int
+                                while (zipIn.read(buffer).also { len = it } != -1) {
+                                    fos.write(buffer, 0, len)
+                                }
+                            }
+                        }
+                    }
+                    zipIn.closeEntry()
+                    count++
+                    if (count % 80 == 0 || count == 16592) {
+                        val currentCount = count
+                        val currentName = entry.name
+                        runOnUiThread {
+                            progressDialog.progress = currentCount
+                            progressDialog.setMessage("已解压 $currentCount / 16592 文件...\n${currentName.substringAfterLast('/')}")
+                        }
+                    }
+                    entry = zipIn.nextEntry
+                }
+                zipIn.close()
+                inputStream.close()
+
+                runOnUiThread {
+                    progressDialog.dismiss()
+                    Toast.makeText(this@MainActivity, "解压成功！正在加载游戏...", Toast.LENGTH_SHORT).show()
+                    applyGameDirectory(targetBase)
+                }
+            } catch (e: Exception) {
+                Log.e(TAG, "解压异常", e)
+                runOnUiThread {
+                    progressDialog.dismiss()
+                    AlertDialog.Builder(this@MainActivity)
+                        .setTitle("解压中断")
+                        .setMessage("解压失败: ${e.message}\n请检查手机内部存储空间是否充足（需预留至少 8GB 空间）。")
+                        .setPositiveButton("重试") { _, _ -> openZipPicker() }
+                        .setNegativeButton("取消", null)
+                        .show()
+                }
+            }
+        }.start()
+    }
