+  --muted: #74635d;
+  --accent: #91374c;
+  --line: #ddcfc3;
+  --shelf-width: 760px;
+  position: fixed;
+  inset: 0;
+  z-index: 99999;
+  overflow: hidden;
+  color: var(--ink);
+  background: #211d1e;
+  font: 14px/1.45 "WebgalUI", sans-serif;
+  user-select: none;
+}
+
+.readerApp {
+  --reader-top: calc(58px + env(safe-area-inset-top, 0px));
+  --reader-bottom: calc(54px + env(safe-area-inset-bottom, 0px));
+  position: relative;
+  width: 100%;
+  height: 100%;
+}
+
+.topBar {
+  position: absolute;
+  inset: 0 0 auto;
+  z-index: 45;
+  display: grid;
+  grid-template-columns: 1fr minmax(0, 2fr) 1fr;
+  align-items: center;
+  gap: 12px;
+  box-sizing: border-box;
+  height: var(--reader-top);
+  padding: env(safe-area-inset-top, 0px) calc(16px + env(safe-area-inset-right, 0px))
+    0 calc(16px + env(safe-area-inset-left, 0px));
+  background: var(--paper);
+  border-bottom: 1px solid var(--line);
+  transition: transform 180ms ease;
+}
+
+.topBarHidden {
+  transform: translateY(-100%);
+  visibility: hidden;
+}
+
+.topLeft, .topRight {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  min-width: max-content;
+}
+
+.topRight { justify-content: flex-end; }
+
+.wgBtn, .drawerCloseBtn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  min-height: 44px;
+  padding: 0 10px;
+  border: 0;
+  border-radius: 4px;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  white-space: nowrap;
+  cursor: pointer;
+
+  svg { width: 17px; height: 17px; flex: 0 0 auto; fill: currentColor; }
+  &:hover, &:focus-visible { background: #efe4da; }
+}
+
+.backBtn, .activeBtn { color: var(--accent); }
+.activeBtn { background: #f4e3e4; }
+
+.titleBox {
+  text-align: center;
+  min-width: 0;
+  cursor: pointer;
+}
+
+.mainTitle, .volName {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-weight: 700;
+}
+.mainTitle { font-size: 15px; }
+.subTitle, .volProgressRow, .bmTime {
+  font-size: 12px;
+  color: var(--muted);
+  white-space: nowrap;
+}
+
+.zoneLeft, .zoneMid, .zoneRight {
+  position: absolute;
+  top: var(--reader-top);
+  bottom: var(--reader-bottom);
+  z-index: 10;
+  touch-action: none;
+}
+.zoneLeft, .zoneRight { width: 32%; cursor: pointer; }
+.zoneLeft { left: 0; }
+.zoneMid { left: 32%; width: 36%; }
+.zoneRight { right: 0; }
+
+.viewport {
+  display: grid;
+  place-items: center;
+  box-sizing: border-box;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+  padding: calc(var(--reader-top) + 8px) calc(8px + env(safe-area-inset-right, 0px))
+    calc(var(--reader-bottom) + 8px) calc(8px + env(safe-area-inset-left, 0px));
+}
+.immersive {
+  --reader-top: env(safe-area-inset-top, 0px);
+  --reader-bottom: env(safe-area-inset-bottom, 0px);
+}
+.spreadContainer {
+  display: grid;
+  place-items: center;
+  height: 100%;
+  min-height: 0;
+  max-width: 100%;
+}
+.mangaPage {
+  max-width: 100%;
+  max-height: 100%;
+  display: block;
+  object-fit: contain;
+  box-shadow: 0 5px 20px #0007;
+}
+
+.bottomBar {
+  position: absolute;
+  inset: auto 0 0;
+  height: var(--reader-bottom);
+  box-sizing: border-box;
+  padding: 0 calc(12px + env(safe-area-inset-right, 0px))
+    env(safe-area-inset-bottom, 0px) calc(12px + env(safe-area-inset-left, 0px));
+  background: var(--paper);
+  border-top: 1px solid var(--line);
+  z-index: 35;
+}
+.bottomBarHidden { visibility: hidden; }
+
+.sliderRow {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  max-width: var(--shelf-width);
+  height: 100%;
+  margin: auto;
+}
+.readerOverlay input.pageSlider {
+  appearance: none;
+  -webkit-appearance: none;
+  flex: 1;
+  min-width: 0;
+  height: 44px;
+  margin: 0;
+  cursor: pointer;
+  padding: 0;
+  border: 0;
+  box-shadow: none;
+  background: transparent;
+
+  &::-webkit-slider-runnable-track {
+    height: 3px;
+    border-radius: 3px;
+    background: #ceb9b1;
+    box-shadow: none;
+  }
+
+  &::-webkit-slider-thumb {
+    appearance: none;
+    -webkit-appearance: none;
+    width: 16px;
+    height: 16px;
+    margin-top: -6.5px;
+    border: 0;
+    border-radius: 50%;
+    background: var(--accent);
+    box-shadow: none;
+  }
+
+  &::-moz-range-track { height: 3px; background: #ceb9b1; }
+  &::-moz-range-thumb { width: 16px; height: 16px; border: 0; background: var(--accent); }
+}
+.pageIndicator {
+  text-align: right;
+  min-width: 72px;
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+.drawerOverlay { position: absolute; inset: 0; z-index: 39; background: #15101399; }
+.drawer {
+  position: absolute;
+  z-index: 42;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: 0 0 10px 10px;
+  box-shadow: 0 10px 30px #0005;
+
+  &[hidden] { display: none; }
+}
+
+.drawerTop {
+  top: var(--reader-top);
+  left: 50%;
+  transform: translateX(-50%);
+  width: min(var(--shelf-width), calc(100% - 16px));
+  max-height: calc(100% - var(--reader-top) - 18px - env(safe-area-inset-bottom, 0px));
+  box-sizing: border-box;
+}
+
+.drawerHeader {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  flex: 0 0 auto;
+  padding: 4px 12px;
+  border-bottom: 1px solid var(--line);
+}
+.drawerHeaderTitle {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-weight: 700;
+}
+.headerIcon { width: 17px; height: 17px; fill: var(--accent); }
+
+.drawerBodyGrid, .drawerBodyBookmark {
+  overflow-y: auto;
+  min-height: 0;
+  padding: 8px 12px 12px;
+  overscroll-behavior: contain;
+  touch-action: pan-y;
+}
+.drawerBodyGrid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr));
+  column-gap: 14px;
+}
+
+.volCard, .bmCard, .track {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-height: 48px;
+  box-sizing: border-box;
+  padding: 6px 8px;
+  border-bottom: 1px solid var(--line);
+  cursor: pointer;
+}
+.volCard:hover, .bmCard:hover, .track:hover { background: #efe4da; }
+.volCardActive, .track[aria-pressed="true"] { background: #f4e3e4; color: var(--accent); }
+.volNum { min-width: 25px; color: var(--accent); font-variant-numeric: tabular-nums; }
+.volDetails { min-width: 0; }
+.bmCard { justify-content: space-between; }
+.bmTitle { font-weight: 700; }
+.bmDelBtn { min-height: 44px; display: grid; place-items: center; color: var(--accent); }
+.track {
+  appearance: none;
+  width: 100%;
+  border: 0;
+  border-bottom: 1px solid var(--line);
+  background: none;
+  color: inherit;
+  font: inherit;
+  text-align: left;
+}
+
+.emptyDrawerTip { margin: 0; padding: 16px; color: var(--muted); text-align: center; }
+.readerOverlay > .emptyDrawerTip { color: var(--paper); }
+
+.historyToast {
+  position: absolute;
+  top: calc(var(--reader-top) + 8px);
+  left: 50%;
+  transform: translateX(-50%);
+  z-index: 37;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  width: max-content;
+  max-width: calc(100% - 16px);
+  box-sizing: border-box;
+  padding: 4px 10px;
+  border-radius: 5px;
+  background: var(--paper);
+  box-shadow: 0 3px 12px #0004;
+  font-size: 12px;
+}
+.historyBtn, .toastClose {
+  color: var(--accent);
+  font: inherit;
+  background: none;
+  border: 0;
+  min-height: 44px;
+  white-space: nowrap;
+  cursor: pointer;
+}
+.toastClose { display: grid; place-items: center; min-width: 32px; }
+
+.forcePortrait .readerApp {
+  --reader-top: calc(78px + env(safe-area-inset-top, 0px));
+}
+.forcePortrait .immersive {
+  --reader-top: env(safe-area-inset-top, 0px);
+}
+.forcePortrait {
+  .topBar {
+    grid-template-columns: repeat(5, minmax(0, 1fr));
+    grid-template-rows: 44px 24px;
+    gap: 0 2px;
+    padding-inline: calc(6px + env(safe-area-inset-left, 0px)) calc(6px + env(safe-area-inset-right, 0px));
+  }
+  .topLeft, .topRight { display: contents; }
+  .wgBtn { min-width: 0; padding: 0 2px; gap: 3px; font-size: 12px; }
+  .wgBtn svg { width: 14px; height: 14px; }
